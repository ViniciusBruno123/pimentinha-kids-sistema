@model CRBVendas.Models.Venda

@{
    ViewData["Title"] = "Excluir Venda";
}

<h1 class="mb-4 text-danger">Excluir Venda</h1>

<div class="alert alert-warning">
    Tem certeza de que deseja excluir esta venda?
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Id</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Cliente</dt>
            <dd class="col-sm-9">@Model.Cliente?.Nome</dd>

            <dt class="col-sm-3">Fornecedor</dt>
            <dd class="col-sm-9">@Model.Fornecedor?.Nome</dd>

            <dt class="col-sm-3">Valor</dt>
            <dd class="col-sm-9">@Model.Valor.ToString("C")</dd>

            <dt class="col-sm-3">Previsão faturamento</dt>
            <dd class="col-sm-9">@Model.PrevisaoFaturamento.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Comissão estimada</dt>
            <dd class="col-sm-9">@(((decimal)ViewBag.Comissao).ToString("C"))</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Confirmar exclusão</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>