@model CRBVendas.Models.ViewModels.VendaFormViewModel

@{
    ViewData["Title"] = "Nova Venda";
}

<h1 class="mb-4">Nova Venda</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card mb-4 shadow-sm">
        <div class="card-header">
            <strong>Dados da venda</strong>
        </div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label asp-for="ClienteId" class="form-label"></label>
                <select asp-for="ClienteId" asp-items="Model.Clientes" class="form-select">
                    <option value="">Selecione...</option>
                </select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="FornecedorId" class="form-label"></label>
                <select asp-for="FornecedorId" asp-items="Model.Fornecedores" class="form-select">
                    <option value="">Selecione...</option>
                </select>
                <span asp-validation-for="FornecedorId" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Valor" class="form-label"></label>
                <input asp-for="Valor" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Valor" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="DescontoOfertado" class="form-label"></label>
                <select asp-for="DescontoOfertado" asp-items="Model.Descontos" class="form-select"></select>
                <span asp-validation-for="DescontoOfertado" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="DataVenda" class="form-label"></label>
                <input asp-for="DataVenda" class="form-control" type="date" />
                <span asp-validation-for="DataVenda" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="PrevisaoFaturamento" class="form-label"></label>
                <input asp-for="PrevisaoFaturamento" class="form-control" type="date" />
                <span asp-validation-for="PrevisaoFaturamento" class="text-danger"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="Obs" class="form-label"></label>
                <input asp-for="Obs" class="form-control" maxlength="100" />
                <span asp-validation-for="Obs" class="text-danger"></span>
            </div>

            <div class="col-md-12 form-check mt-3 ms-2">
                <input asp-for="Faturado" class="form-check-input" />
                <label asp-for="Faturado" class="form-check-label"></label>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Salvar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}