@model CRBVendas.Models.Contato

@{
    ViewData["Title"] = "Detalhes do Contato";
}


<h1 class="mb-4">
    Detalhes do Contato
</h1>


<div class="card mb-4 shadow-sm">

<div class="card-header">
<strong>Dados principais</strong>
</div>


<div class="card-body">

<dl class="row">

<dt class="col-sm-3">
Nome Fantasia
</dt>

<dd class="col-sm-9">
@Model.NomeFantasia
</dd>


<dt class="col-sm-3">
Contato
</dt>

<dd class="col-sm-9">
@(Model.NomeContato ?? "-")
</dd>

<dt class="col-sm-3">
Agenda atual
</dt>

<dd class="col-sm-9">
@(Model.AgendaAtual?.ToString("dd/MM/yyyy") ?? "-")
</dd>


<dt class="col-sm-3">
Próxima agenda
</dt>

<dd class="col-sm-9">
@(Model.AgendaProxima?.ToString("dd/MM/yyyy") ?? "-")
</dd>

<dt class="col-sm-3">
Observação
</dt>

<dd class="col-sm-9">
@(Model.Observacao ?? "-")
</dd>

<div class="card shadow-sm mb-4">
    <div class="card-header">
        <strong>Telefones</strong>
    </div>
    <div class="card-body">
        @if (Model.Telefones != null && Model.Telefones.Any())
        {
            <ul class="mb-0">
                @foreach (var telefone in Model.Telefones)
                {
                    <li>@Formatador.Telefone(telefone.Telefone)</li>
                }
            </ul>
        }
        else
        {
            <span class="text-muted">Nenhum telefone cadastrado.</span>
        }
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header">
        <strong>Endereços</strong>
    </div>
    <div class="card-body">
        @if (Model.Endereco != null)
        {
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Logradouro</th>
                            <th>Número</th>
                            <th>Cidade</th>
                            <th>CEP</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@Model.Endereco.Logradouro</td>
                            <td>@Model.Endereco.Numero</td>
                            <td>@Model.Endereco.Cidade</td>
                            <td>@Formatador.CEP(Model.Endereco.CEP)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <span class="text-muted">Nenhum endereço cadastrado.</span>
        }
    </div>
</div>


</dl>

</div>

</div>