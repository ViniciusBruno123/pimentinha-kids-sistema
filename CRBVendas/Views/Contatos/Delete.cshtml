@model CRBVendas.Models.Contato

@{
    ViewData["Title"] = "Excluir Contato";
}

<h1 class="mb-4">Excluir Contato</h1>


<div class="alert alert-danger">
    <strong>Atenção!</strong>
    Tem certeza que deseja excluir este contato?
</div>



<div class="card shadow-sm mb-4">


    <div class="card-header">
        <strong>Dados do contato</strong>
    </div>


    <div class="card-body">


        <dl class="row mb-0">


            <dt class="col-sm-3">
                Nome Fantasia
            </dt>

            <dd class="col-sm-9">
                @Model.NomeFantasia
            </dd>



            <dt class="col-sm-3">
                Nome do Contato
            </dt>

            <dd class="col-sm-9">
                @(Model.NomeContato ?? "-")
            </dd>



            <dt class="col-sm-3">
                Próxima Agenda
            </dt>

            <dd class="col-sm-9">

                @(Model.AgendaProxima.HasValue
                    ? Model.AgendaProxima.Value.ToString("dd/MM/yyyy")
                    : "-")

            </dd>



            <dt class="col-sm-3">
                Telefones
            </dt>

            <dd class="col-sm-9">

                @if(Model.Telefones != null && Model.Telefones.Any())
                {
                    @string.Join(" / ",
                    Model.Telefones.Select(t => t.Telefone))
                }
                else
                {
                    <span class="text-muted">
                        Nenhum telefone
                    </span>
                }

            </dd>



            <dt class="col-sm-3">
                Cidade
            </dt>

            <dd class="col-sm-9">

                @(Model.Endereco?.Cidade ?? "-")

            </dd>


        </dl>


    </div>

</div>




<form asp-action="Delete" method="post">


    <input type="hidden" asp-for="Id" />


    <button type="submit"
            class="btn btn-danger">

        Excluir

    </button>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        Cancelar

    </a>


</form>