@model CRBVendas.Models.Contato

@{
    ViewData["Title"] = "Editar Contato";
}

<h1 class="mb-4">Editar Contato</h1>


<form asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>


    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>Dados principais</strong>
        </div>


        <div class="card-body row g-3">


            <div class="col-md-8">

                <label asp-for="NomeFantasia" class="form-label"></label>

                <input asp-for="NomeFantasia" class="form-control" />

                <span asp-validation-for="NomeFantasia"
                      class="text-danger"></span>

            </div>


            <div class="col-md-4">

                <label asp-for="NomeContato" class="form-label"></label>

                <input asp-for="NomeContato"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label asp-for="AgendaAtual" class="form-label"></label>

                <input asp-for="AgendaAtual"
                       type="date"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label asp-for="AgendaProxima" class="form-label"></label>

                <input asp-for="AgendaProxima"
                       type="date"
                       class="form-control" />

            </div>


            <div class="col-md-12">

                <label asp-for="Observacao"
                       class="form-label"></label>


                <textarea asp-for="Observacao"
                          class="form-control"
                          rows="3"></textarea>

            </div>


        </div>

    </div>





    <div class="card shadow-sm mb-4">


        <div class="card-header d-flex justify-content-between align-items-center">

            <strong>Telefones</strong>


            <button type="button"
                    class="btn btn-sm btn-outline-primary"
                    onclick="adicionarTelefone()">

                Adicionar telefone

            </button>

        </div>


        <div class="card-body">


            <div id="telefones-container">


                @for (int i = 0; i < Model.Telefones.Count; i++)
                {

                    <div class="row g-2 mb-2 telefone-item">


                        <input type="hidden"
                               name="Telefones[@i].Id"
                               value="@Model.Telefones[i].Id" />


                        <input type="hidden"
                               name="Telefones[@i].ContatoId"
                               value="@Model.Id" />


                        <div class="col-md-10">


                            <input name="Telefones[@i].Telefone"
                                   value="@Model.Telefones[i].Telefone"
                                   class="form-control"
                                   placeholder="Telefone" />

                        </div>


                        <div class="col-md-2">


                            <button type="button"
                                    class="btn btn-outline-danger w-100"
                                    onclick="removerItem(this)">

                                Remover

                            </button>


                        </div>


                    </div>

                }


            </div>


        </div>


    </div>






    <div class="card shadow-sm mb-4">


        <div class="card-header">

            <strong>Endereço</strong>

        </div>



        <div class="card-body row g-3">


            @if(Model.Endereco != null)
            {

                <input type="hidden"
                       asp-for="Endereco.Id" />


                <input type="hidden"
                       asp-for="Endereco.ContatoId" />

            }


            <div class="col-md-6">


                <label class="form-label">
                    Logradouro
                </label>


                <input asp-for="Endereco.Logradouro"
                       class="form-control"
                       placeholder="Logradouro" />


            </div>



            <div class="col-md-2">


                <label class="form-label">
                    Número
                </label>


                <input asp-for="Endereco.Numero"
                       class="form-control"
                       placeholder="Número" />


            </div>




            <div class="col-md-3">


                <label class="form-label">
                    Cidade
                </label>


                <input asp-for="Endereco.Cidade"
                       class="form-control"
                       placeholder="Cidade" />


            </div>




            <div class="col-md-1">


                <label class="form-label">
                    CEP
                </label>


                <input asp-for="Endereco.CEP"
                       class="form-control"
                       placeholder="CEP" />


            </div>


        </div>


    </div>





    <div class="d-flex gap-2">


        <button type="submit"
                class="btn btn-success">

            Salvar alterações

        </button>


        <a asp-action="Index"
           class="btn btn-outline-secondary">

            Cancelar

        </a>


    </div>


</form>





@section Scripts {


<partial name="_ValidationScriptsPartial" />


<script>


function removerItem(botao)
{
    botao.closest(".telefone-item").remove();

    reindexarTelefones();
}




function adicionarTelefone()
{

    const container =
        document.getElementById("telefones-container");


    const index =
        container.querySelectorAll(".telefone-item").length;



    const contatoId =
        document.querySelector('input[name="Id"]').value;



    const html = `

    <div class="row g-2 mb-2 telefone-item">


        <input type="hidden"
               name="Telefones[${index}].Id"
               value="0" />


        <input type="hidden"
               name="Telefones[${index}].ContatoId"
               value="${contatoId}" />



        <div class="col-md-10">

            <input name="Telefones[${index}].Telefone"
                   class="form-control"
                   placeholder="Telefone" />

        </div>


        <div class="col-md-2">

            <button type="button"
                    class="btn btn-outline-danger w-100"
                    onclick="removerItem(this)">
                Remover
            </button>

        </div>


    </div>

    `;



    container.insertAdjacentHTML(
        "beforeend",
        html
    );

}





function reindexarTelefones()
{

    const itens =
        document.querySelectorAll(
            "#telefones-container .telefone-item"
        );


    itens.forEach((item,index)=>{


        const inputs =
            item.querySelectorAll("input");


        inputs[0].name =
            `Telefones[${index}].Id`;


        inputs[1].name =
            `Telefones[${index}].ContatoId`;


        inputs[2].name =
            `Telefones[${index}].Telefone`;

    });

}


</script>


}