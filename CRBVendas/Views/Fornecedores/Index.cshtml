@model IEnumerable<CRBVendas.Models.Fornecedor>

@{
    ViewData["Title"] = "Fornecedores";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Fornecedores</h1>
    <a asp-action="Create" class="btn btn-primary">Novo fornecedor</a>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<form method="get" asp-action="Index" class="row g-3 mb-4">
    <div class="col-md-6">
        <label class="form-label">Nome</label>
        <input type="text" name="nome" value="@ViewBag.FiltroNome" class="form-control" placeholder="Buscar por nome" />
    </div>

    <div class="col-md-6 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">Pesquisar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>Representante</th>
                <th>Telefones</th>
                <th>Cidades</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var fornecedor in Model)
                {
                    <tr>
                        <td>@fornecedor.Nome</td>
                        <td>@fornecedor.Representante</td>
                        <td>
                            @if (fornecedor.Telefones != null && fornecedor.Telefones.Any())
                            {
                                @string.Join(" / ", fornecedor.Telefones.Select(t => Formatador.Telefone(t.Telefone)))
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (fornecedor.Enderecos != null && fornecedor.Enderecos.Any())
                            {
                                @string.Join(" / ", fornecedor.Enderecos.Select(e => e.Cidade).Distinct())
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@fornecedor.Id" class="btn btn-sm btn-outline-info">Detalhes</a>
                            <a asp-action="Edit" asp-route-id="@fornecedor.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@fornecedor.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Nenhum fornecedor encontrado.</td>
                </tr>
            }
        </tbody>
    </table>
</div>