@model IEnumerable<CRBVendas.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Clientes</h1>
    <a asp-action="Create" class="btn btn-primary">Novo cliente</a>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<form method="get" asp-action="Index" class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="form-label">Razão Social</label>
        <input type="text" name="nome" value="@ViewBag.FiltroNome" class="form-control" placeholder="Buscar por razão social" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Nome Fantasia</label>
        <input type="text" name="nomefantasia" value="@ViewBag.FiltroNomeFantasia" class="form-control" placeholder="Buscar por nome fantasia" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Cidade</label>
        <input type="text" name="cidade" value="@ViewBag.FiltroCidade" class="form-control" placeholder="Buscar por cidade" />
    </div>

    <div class="col-md-4 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">Pesquisar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>NomeFantasia</th>
                <th>Representante</th>
                <th>Cidades</th>
                <th>CNPJ</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Nome</td>
                        <td>@cliente.NomeFantasia</td>
                        <td>@cliente.Representante</td>
                        <td>
                            @if (cliente.Enderecos != null && cliente.Enderecos.Any())
                            {
                                @string.Join(" / ", cliente.Enderecos.Select(e => e.Cidade).Distinct())
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>@Formatador.CNPJ(cliente.CNPJ)</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-info">Detalhes</a>
                            <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Nenhum cliente encontrado.</td>
                </tr>
            }
        </tbody>
    </table>
</div>